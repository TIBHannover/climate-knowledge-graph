<?xml version="1.0" encoding="UTF-8"?>
<!--
    project-template.fodt  –  Flat OpenDocument Text (open in LibreOffice Writer)
    OpenRewi Publication Pipeline – Bilingual Project Information Template
    =========================================================================
    PURPOSE : Source of truth for all project outputs (XML, HTML, README, Wikidata).
    HOW     : Fill in / update the EN and DE columns.
              Pass the updated file to the technical team who will update the
              XML instances and regenerate HTML + other outputs.
    SCHEMA  : https://schema.org/ResearchProject  |  DTD: ResearchProject.dtd
    PIPELINE: See pipeline.md for the full workflow description.
-->
<office:document
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  office:mimetype="application/vnd.oasis.opendocument.text"
  office:version="1.3">

  <office:meta>
    <meta:creation-date>2026-06-11T00:00:00</meta:creation-date>
    <dc:title>ResearchProject Information Template – OpenRewi Publication Pipeline</dc:title>
    <dc:description>Bilingual EN/DE source-of-truth template. Fill in and pass to technical team to regenerate XML and HTML outputs.</dc:description>
  </office:meta>

  <office:scripts/>
  <office:font-face-decls/>

  <!-- ============================================================
       NAMED PARAGRAPH STYLES
  ============================================================ -->
  <office:styles>

    <style:default-style style:family="paragraph">
      <style:paragraph-properties fo:margin-bottom="0.15cm" style:writing-mode="lr-tb"/>
      <style:text-properties fo:font-size="10pt" fo:language="en" fo:country="GB"/>
    </style:default-style>

    <style:style style:name="Standard" style:family="paragraph" style:class="text">
      <style:paragraph-properties fo:margin-bottom="0.15cm"/>
      <style:text-properties fo:font-size="10pt"/>
    </style:style>

    <style:style style:name="Heading 1" style:family="paragraph"
      style:parent-style-name="Standard" style:next-style-name="Standard" style:class="text">
      <style:paragraph-properties fo:margin-top="0.5cm" fo:margin-bottom="0.25cm"
        fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#1a3a5c"/>
    </style:style>

    <style:style style:name="Heading 2" style:family="paragraph"
      style:parent-style-name="Standard" style:next-style-name="Standard" style:class="text">
      <style:paragraph-properties fo:margin-top="0.45cm" fo:margin-bottom="0.15cm"
        fo:border-bottom="1pt solid #2563a8" fo:padding-bottom="0.08cm"
        fo:keep-with-next="always"/>
      <style:text-properties fo:font-size="12pt" fo:font-weight="bold" fo:color="#1a5276"/>
    </style:style>

    <style:style style:name="Instruction Box" style:family="paragraph"
      style:parent-style-name="Standard">
      <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0.3cm"
        fo:padding="0.2cm"
        fo:border-top="0.5pt solid #93c5e0" fo:border-bottom="0.5pt solid #93c5e0"
        fo:border-left="3pt solid #2563a8" fo:border-right="0.5pt solid #93c5e0"
        fo:background-color="#ebf5fb"/>
      <style:text-properties fo:font-size="9pt" fo:font-style="italic" fo:color="#1a5276"/>
    </style:style>

    <style:style style:name="Table Contents" style:family="paragraph"
      style:parent-style-name="Standard" style:class="extra">
      <style:paragraph-properties fo:margin-top="0.04cm" fo:margin-bottom="0.04cm"/>
      <style:text-properties fo:font-size="9pt"/>
    </style:style>

    <style:style style:name="Table Header" style:family="paragraph"
      style:parent-style-name="Table Contents" style:class="extra">
      <style:text-properties fo:font-weight="bold" fo:color="#ffffff" fo:font-size="9pt"/>
    </style:style>

    <style:style style:name="Table Label" style:family="paragraph"
      style:parent-style-name="Table Contents">
      <style:text-properties fo:font-weight="bold" fo:color="#1a3a5c" fo:font-size="8.5pt"/>
    </style:style>

    <style:style style:name="Table Note" style:family="paragraph"
      style:parent-style-name="Table Contents">
      <style:text-properties fo:font-style="italic" fo:color="#888888" fo:font-size="7.5pt"/>
    </style:style>

    <style:style style:name="Table Section" style:family="paragraph"
      style:parent-style-name="Table Contents">
      <style:text-properties fo:font-weight="bold" fo:color="#1a5276" fo:font-size="8pt"
        fo:font-style="italic"/>
    </style:style>

  </office:styles>

  <!-- ============================================================
       AUTOMATIC STYLES  (table structure, page layout)
  ============================================================ -->
  <office:automatic-styles>

    <!-- Page: A4, 2 cm margins -->
    <style:page-layout style:name="pm1">
      <style:page-layout-properties
        fo:page-width="21cm" fo:page-height="29.7cm"
        style:print-orientation="portrait"
        fo:margin-top="2cm" fo:margin-bottom="2cm"
        fo:margin-left="2cm" fo:margin-right="2cm"/>
    </style:page-layout>

    <!-- Tables -->
    <style:style style:name="tbl.active" style:family="table">
      <style:table-properties style:width="16.5cm" table:align="left"
        fo:margin-bottom="0.5cm"/>
    </style:style>
    <style:style style:name="tbl.unused" style:family="table">
      <style:table-properties style:width="16.5cm" table:align="left"
        fo:margin-bottom="0.5cm"/>
    </style:style>

    <!-- Columns: active table -->
    <style:style style:name="col.label" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="col.en" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="col.de" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>

    <!-- Columns: unused fields table -->
    <style:style style:name="col.uf" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="col.ud" style:family="table-column">
      <style:table-column-properties style:column-width="12cm"/>
    </style:style>

    <!-- Rows -->
    <style:style style:name="row.hdr" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.7cm"/>
    </style:style>
    <style:style style:name="row.data" style:family="table-row">
      <style:table-row-properties style:min-row-height="0.55cm"/>
    </style:style>

    <!-- Cells: active table -->
    <style:style style:name="cell.header" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm"
        fo:border="0.5pt solid #0d2137"
        fo:background-color="#1a3a5c" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="cell.label" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm"
        fo:border="0.5pt solid #9ab8d0"
        fo:background-color="#dce8f4" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="cell.en" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm 0.18cm"
        fo:border="0.5pt solid #9ab8d0"
        fo:background-color="#ffffff" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="cell.de" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.12cm 0.18cm"
        fo:border="0.5pt solid #9ab8d0"
        fo:background-color="#fffff8" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="cell.span" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.08cm 0.12cm"
        fo:border="0.5pt solid #7aaac8"
        fo:background-color="#c8dff0" style:vertical-align="middle"/>
    </style:style>

    <!-- Cells: unused table -->
    <style:style style:name="cell.uf" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm"
        fo:border="0.5pt solid #cccccc"
        fo:background-color="#efefef" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="cell.ud" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm"
        fo:border="0.5pt solid #cccccc"
        fo:background-color="#fafafa" style:vertical-align="top"/>
    </style:style>
    <style:style style:name="cell.usec" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.07cm 0.12cm"
        fo:border="0.5pt solid #aaaaaa"
        fo:background-color="#e0e0e0" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="cell.uheader" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm"
        fo:border="0.5pt solid #555555"
        fo:background-color="#555555" style:vertical-align="middle"/>
    </style:style>

  </office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="pm1"/>
  </office:master-styles>

  <!-- ============================================================
       DOCUMENT BODY
  ============================================================ -->
  <office:body>
    <office:text>

      <!-- Title -->
      <text:h text:style-name="Heading 1" text:outline-level="1"
        >ResearchProject — Project Information Template</text:h>
      <text:h text:style-name="Heading 2" text:outline-level="2"
        >OpenRewi Publication Pipeline (OPP)</text:h>

      <!-- Instructions -->
      <text:p text:style-name="Instruction Box">Instructions for non-technical editors: This document is the source of truth for all project information outputs (XML, HTML webpage, GitLab README, Wikidata entries, etc.). Fill in or update the English (EN) and German (DE) columns below. URLs, identifiers, and names that do not require translation — write "(= EN)" in the DE column. When done, pass the updated file to the technical team who will update the XML files and regenerate all outputs. Schema reference: https://schema.org/ResearchProject | DTD: ResearchProject.dtd</text:p>

      <!-- =========================================================
           SECTION 1: ACTIVE FIELDS
      ========================================================= -->
      <text:h text:style-name="Heading 2" text:outline-level="2"
        >Active Project Fields</text:h>

      <table:table table:name="ActiveFields" table:style-name="tbl.active">
        <table:table-column table:style-name="col.label"/>
        <table:table-column table:style-name="col.en"/>
        <table:table-column table:style-name="col.de"/>

        <!-- HEADER ROW -->
        <table:table-row table:style-name="row.hdr">
          <table:table-cell table:style-name="cell.header">
            <text:p text:style-name="Table Header">Field (schema.org)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.header">
            <text:p text:style-name="Table Header">English (EN)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.header">
            <text:p text:style-name="Table Header">Deutsch (DE)</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- name -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">name</text:p>
            <text:p text:style-name="Table Note">Project title</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">OpenRewi Publication Pipeline</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">OpenRewi-Publikationspipeline</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- alternateName -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">alternateName</text:p>
            <text:p text:style-name="Table Note">Acronym / short name</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">OPP</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">(= EN)</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- disambiguatingDescription -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">disambiguatingDescription</text:p>
            <text:p text:style-name="Table Note">Strapline — one sentence for disambiguation</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">Independent publication pipeline for the OpenRewi textbook series</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">Plattformunabhängige Publikationspipeline für die OpenRewi-Lehrbuchreihe</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- description -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">description</text:p>
            <text:p text:style-name="Table Note">Full project description. Separate paragraphs with a blank line.</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">An experimental joint project between the TIB, OpenRewi, and the VEStOR project (University of Applied Sciences Potsdam). It aims to deliver a publication pipeline that is as production-ready as possible for the OpenRewi textbook series. It also serves as a proof of concept for embedding single-source publishing workflows into a comprehensive, digital sovereign publication infrastructure.</text:p>
            <text:p text:style-name="Table Contents"> </text:p>
            <text:p text:style-name="Table Contents">The project aims to establish a technical workflow that transforms open standards word processing files and integrated Zotero citations, used in real-time collaborative environments, into usable data packages for multi-format output. The system design is oriented to standards as opposed to platforms to enable and advocate for bibliodiversity, e.g., Open Document Format, Citation Style Language, W3C CSS Paged Media, and for computational notebooks (Jupyter Notebooks).</text:p>
            <text:p text:style-name="Table Contents"> </text:p>
            <text:p text:style-name="Table Contents">Key aspects: (1) Single-Source Approach: Content is authored in a central environment (e.g., Nextcloud and a word processor) and rendered into web, PDF, and print formats from a single source of data. (2) Technical Stack: The pipeline utilizes Pandoc and Quarto for converting to high-fidelity rendering. (3) Evolution of Tools: Due to technical and licensing shifts the project is currently testing a variety of Nextcloud-based word processors to maintain digital sovereignty. (4) Interactive Content: The workflow enables the use of H5P interactive elements in web versions using Jupyter Notebooks while ensuring they do not disrupt word processing workflows, e.g., static PDF exports.</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">Ein experimentelles Gemeinschaftsprojekt der TIB, OpenRewi und des VEStOR-Projekts (Hochschule für Technik und Wirtschaft Potsdam). Ziel ist es, eine möglichst produktionsreife Publikationspipeline für die OpenRewi-Lehrbuchreihe bereitzustellen. Das Projekt dient zudem als Proof of Concept für die Einbettung von Single-Source-Publishing-Workflows in eine umfassende, digital souveräne Publikationsinfrastruktur.</text:p>
            <text:p text:style-name="Table Contents"> </text:p>
            <text:p text:style-name="Table Contents">Das Projekt zielt darauf ab, einen technischen Workflow zu etablieren, der Textverarbeitungsdateien nach offenen Standards und integrierte Zotero-Zitate, die in Echtzeit-Kollaborationsumgebungen verwendet werden, in nutzbare Datenpakete für die Ausgabe in verschiedenen Formaten umwandelt. Das Systemdesign orientiert sich an Standards statt an Plattformen, um Bibliodiversität zu ermöglichen und zu fördern, z. B. Open Document Format, Citation Style Language, W3C CSS Paged Media sowie für computergestützte Notizbücher (Jupyter Notebooks).</text:p>
            <text:p text:style-name="Table Contents"> </text:p>
            <text:p text:style-name="Table Contents">Kernaspekte: (1) Single-Source-Ansatz: Inhalte werden in einer zentralen Umgebung (z. B. Nextcloud und einem Textverarbeitungsprogramm) erstellt und aus einer einzigen Datenquelle in Web-, PDF- und Druckformate gerendert. (2) Technischer Stack: Die Pipeline nutzt Pandoc und Quarto für die Konvertierung zu einer originalgetreuen Darstellung. (3) Weiterentwicklung der Tools: Aufgrund technischer und lizenzrechtlicher Veränderungen testet das Projekt derzeit verschiedene Nextcloud-basierte Textverarbeitungsprogramme, um die digitale Souveränität zu wahren. (4) Interaktive Inhalte: Der Workflow ermöglicht die Verwendung interaktiver H5P-Elemente in Webversionen unter Verwendung von Jupyter Notebooks und stellt gleichzeitig sicher, dass diese die Textverarbeitungsabläufe, z. B. statische PDF-Exporte, nicht beeinträchtigen.</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- url -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">url</text:p>
            <text:p text:style-name="Table Note">Primary project URL</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">https://gitlab.com/TIBHannover/open-science-lab/opp</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">(= EN)</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- sameAs -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">sameAs</text:p>
            <text:p text:style-name="Table Note">Related authoritative URLs — one per line</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">https://openrewi.org/</text:p>
            <text:p text:style-name="Table Contents">https://www.fh-potsdam.de/forschung-transfer/projekte/vestor</text:p>
            <text:p text:style-name="Table Contents">https://www.tib.eu/de/forschung-entwicklung/forschungsgruppen-und-labs/open-science</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">(= EN)</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- identifier -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">identifier</text:p>
            <text:p text:style-name="Table Note">Grant / project ID. Use propertyID attribute in XML.</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">VEStOR BMBFSFJ Grant ID 01PO23004A</text:p>
            <text:p text:style-name="Table Note">propertyID="GrantID" value="01PO23004A"</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">VEStOR BMBFSFJ Förderkennzeichen 01PO23004A</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- images / logos -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">image → imageObject</text:p>
            <text:p text:style-name="Table Note">Partner logos. Format: Caption | URL</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Label">OpenRewi logo</text:p>
            <text:p text:style-name="Table Note">https://gitlab.com/TIBHannover/open-science-lab/opp/-/raw/main/images/logos/openrewi-logo.png</text:p>
            <text:p text:style-name="Table Label">VEStOR logo</text:p>
            <text:p text:style-name="Table Note">https://gitlab.com/TIBHannover/open-science-lab/opp/-/raw/main/images/logos/vestor-logo.png</text:p>
            <text:p text:style-name="Table Label">TIB – Leibniz Information Centre for Science and Technology logo</text:p>
            <text:p text:style-name="Table Note">https://gitlab.com/TIBHannover/open-science-lab/opp/-/raw/main/images/logos/tib-logo.png</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">URLs (= EN)</text:p>
            <text:p text:style-name="Table Contents"> </text:p>
            <text:p text:style-name="Table Label">DE captions:</text:p>
            <text:p text:style-name="Table Contents">OpenRewi-Logo</text:p>
            <text:p text:style-name="Table Contents">VEStOR-Logo</text:p>
            <text:p text:style-name="Table Contents">TIB – Leibniz-Informationszentrum Technik und Naturwissenschaften Logo</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- dates -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">foundingDate / dissolutionDate</text:p>
            <text:p text:style-name="Table Note">ISO 8601 (YYYY-MM-DD or YYYY)</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">Start: 2026</text:p>
            <text:p text:style-name="Table Contents">End: 2026</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">(= EN)</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- parentOrganization / Lead -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">parentOrganization</text:p>
            <text:p text:style-name="Table Note">Lead organisation. Include ROR ID as href.</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">VEStOR Project – University of Applied Sciences Potsdam</text:p>
            <text:p text:style-name="Table Note">ROR: https://ror.org/012m9bp23</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.de">
            <text:p text:style-name="Table Contents">VEStOR-Projekt – Hochschule für Technik und Wirtschaft Potsdam</text:p>
            <text:p text:style-name="Table Note">ROR: https://ror.org/012m9bp23</text:p>
          </table:table-cell>
        </table:table-row>

        <!-- member / Team -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.label">
            <text:p text:style-name="Table Label">member</text:p>
            <text:p text:style-name="Table Note">Team members. Format: Name | ORCID iD</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="cell.en">
            <text:p text:style-name="Table Contents">Lambert Heller</text:p>
            <text:p text:style-name="Table Note">ORCID: 0000-0003-0232-7085</text:p>
            <text:p text:style-name="Table Contents">Simon Worthington</text:p>
            <text:p text:style-name="Table Note">ORCID: 0000-0002-8579-9717</text:p>
            <text:p text:style-name="Table Contents">Philipp Falkenburg</text:p>
