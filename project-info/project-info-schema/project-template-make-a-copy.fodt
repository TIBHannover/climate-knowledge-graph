          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Value-added Tax ID with national prefix (e.g. DE123456789)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">isicV4</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">International Standard of Industrial Classification (ISIC) Revision 4 code</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">naics</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">North American Industry Classification System (NAICS) code</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">globalLocationNumber</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Global Location Number (GLN) — 13-digit identifier for parties and locations</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">iso6523Code</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">ISO 6523(-1) organization identifier. Format: XXXX:YYYYYY</text:p></table:table-cell>
        </table:table-row>

        <!-- GROUP: Certification -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.usec" table:number-columns-spanned="2">
            <text:p text:style-name="Table Section">Certification</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">hasCertification</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Certification information: name, certificationIdentification, issuedBy, certificationStatus, validFrom, validThrough</text:p></table:table-cell>
        </table:table-row>

        <!-- GROUP: Schema.org Thing properties -->
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.usec" table:number-columns-spanned="2">
            <text:p text:style-name="Table Section">Schema.org Thing Properties (advanced)</text:p>
          </table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">additionalType</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Additional type from an external vocabulary (Text or URL)</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">mainEntityOfPage</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Page (CreativeWork or URL) for which this thing is the main entity described</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">subjectOf</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">A CreativeWork or Event about this thing</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">potentialAction</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">A potential Action in which this thing plays an object role</text:p></table:table-cell>
        </table:table-row>
        <table:table-row table:style-name="row.data">
          <table:table-cell table:style-name="cell.uf"><text:p text:style-name="Table Label">owner</text:p></table:table-cell>
          <table:table-cell table:style-name="cell.ud"><text:p text:style-name="Table Contents">Person or organization who owns this thing</text:p></table:table-cell>
        </table:table-row>

      </table:table>

    </office:text>
  </office:body>
</office:document>
