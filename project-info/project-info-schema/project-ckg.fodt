      <text:p text:style-name="Table_20_Label">logo</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="UnusedFields.B3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Primary organizational logo (ImageObject or URL). Currently using image* for partner logos.</text:p>
