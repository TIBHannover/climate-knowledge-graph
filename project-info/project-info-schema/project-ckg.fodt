     </table:table-cell>
     <table:table-cell table:style-name="ActiveFields.C2" office:value-type="string">
      <text:p text:style-name="P1">(= EN)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ActiveFields.2">
     <table:table-cell table:style-name="ActiveFields.A2" office:value-type="string">
