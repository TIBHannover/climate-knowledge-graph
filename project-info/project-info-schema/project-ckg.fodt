      <text:p text:style-name="Table_20_Contents">Physical address: streetAddress, addressLocality, addressRegion, postalCode, addressCountry</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="UnusedFields.2">
     <table:table-cell table:style-name="UnusedFields.A3" office:value-type="string">
