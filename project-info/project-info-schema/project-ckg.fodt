     <table:table-cell table:style-name="UnusedFields.A3" office:value-type="string">
      <text:p text:style-name="Table_20_Label">telephone</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="UnusedFields.B3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Telephone number</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="UnusedFields.2">
     <table:table-cell table:style-name="UnusedFields.A3" office:value-type="string">
      <text:p text:style-name="Table_20_Label">faxNumber</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="UnusedFields.B3" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Fax number</text:p>
